{
  "$schema": "http://json-schema.org/draft-07/schema",
  "type": "object",
  "title": "OasgenProvider",
  "description": "Full-coverage values schema for the oasgen-provider chart, pinned to installer 2.7.0 / chart 0.9.0.",
  "additionalProperties": false,
  "properties": {
    "replicaCount": {
      "type": "integer",
      "title": "Replica count"
    },
    "image": {
      "type": "object",
      "title": "Controller image",
      "additionalProperties": false,
      "properties": {
        "registry": {
          "type": "string",
          "title": "Image registry host",
          "description": "Registry host; overridden by global.imageRegistry when set.",
          "default": "ghcr.io"
        },
        "repository": {
          "type": "string",
          "title": "Image repository"
        },
        "pullPolicy": {
          "type": "string",
          "title": "Image pull policy",
          "enum": [
            "IfNotPresent",
            "Always",
            "Never"
          ]
        },
        "tag": {
          "type": "string",
          "title": "Image tag"
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "title": "Image pull secrets",
      "items": {
        "type": "object"
      }
    },
    "nameOverride": {
      "type": "string",
      "title": "Name override"
    },
    "fullnameOverride": {
      "type": "string",
      "title": "Fullname override"
    },
    "serviceAccount": {
      "type": "object",
      "title": "Service account",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean",
          "title": "Create service account"
        },
        "automount": {
          "type": "boolean",
          "title": "Automount API credentials"
        },
        "annotations": {
          "type": "object",
          "title": "Service account annotations"
        },
        "name": {
          "type": "string",
          "title": "Service account name"
        }
      }
    },
    "podAnnotations": {
      "type": "object",
      "title": "Pod annotations"
    },
    "podLabels": {
      "type": "object",
      "title": "Pod labels"
    },
    "podSecurityContext": {
      "type": "object",
      "title": "Pod security context"
    },
    "securityContext": {
      "type": "object",
      "title": "Container security context"
    },
    "service": {
      "type": "object",
      "title": "Service",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "title": "Service type",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "title": "Service port"
        }
      }
    },
    "ingress": {
      "type": "object",
      "title": "Ingress",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "title": "Ingress enabled"
        },
        "className": {
          "type": "string",
          "title": "Ingress class name"
        },
        "annotations": {
          "type": "object",
          "title": "Ingress annotations"
        },
        "hosts": {
          "type": "array",
          "title": "Ingress hosts",
          "items": {
            "type": "object",
            "properties": {
              "host": {
                "type": "string"
              },
              "paths": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "pathType": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "tls": {
          "type": "array",
          "title": "Ingress TLS",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "title": "Resources"
    },
    "autoscaling": {
      "type": "object",
      "title": "Autoscaling",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "title": "Autoscaling enabled"
        },
        "minReplicas": {
          "type": "integer",
          "title": "Minimum replicas"
        },
        "maxReplicas": {
          "type": "integer",
          "title": "Maximum replicas"
        },
        "targetCPUUtilizationPercentage": {
          "type": "integer",
          "title": "Target CPU utilization percentage"
        },
        "targetMemoryUtilizationPercentage": {
          "type": "integer",
          "title": "Target memory utilization percentage"
        }
      }
    },
    "volumes": {
      "type": "array",
      "title": "Additional volumes",
      "items": {
        "type": "object"
      }
    },
    "volumeMounts": {
      "type": "array",
      "title": "Additional volume mounts",
      "items": {
        "type": "object"
      }
    },
    "nodeSelector": {
      "type": "object",
      "title": "Node selector"
    },
    "tolerations": {
      "type": "array",
      "title": "Tolerations",
      "items": {
        "type": "object"
      }
    },
    "affinity": {
      "type": "object",
      "title": "Affinity"
    },
    "rdc": {
      "type": "object",
      "title": "rest-dynamic-controller (rdc)",
      "description": "Values for the rest-dynamic-controller sub-block deployed by oasgen-provider.",
      "additionalProperties": false,
      "properties": {
        "image": {
          "type": "object",
          "title": "rdc image",
          "additionalProperties": false,
          "properties": {
            "registry": {
              "type": "string",
              "title": "Image registry host",
              "description": "Registry host; overridden by global.imageRegistry when set.",
              "default": "ghcr.io"
            },
            "repository": {
              "type": "string",
              "title": "Image repository"
            },
            "pullPolicy": {
              "type": "string",
              "title": "Image pull policy",
              "enum": [
                "IfNotPresent",
                "Always",
                "Never"
              ]
            },
            "tag": {
              "type": "string",
              "title": "Image tag"
            }
          }
        },
        "replicaCount": {
          "type": "integer",
          "title": "Replica count"
        },
        "imagePullSecrets": {
          "type": "array",
          "title": "Image pull secrets",
          "items": {
            "type": "object"
          }
        },
        "nameOverride": {
          "type": "string",
          "title": "Name override"
        },
        "fullnameOverride": {
          "type": "string",
          "title": "Fullname override"
        },
        "serviceAccount": {
          "type": "object",
          "title": "Service account",
          "additionalProperties": false,
          "properties": {
            "create": {
              "type": "boolean",
              "title": "Create service account"
            },
            "automount": {
              "type": "boolean",
              "title": "Automount API credentials"
            },
            "annotations": {
              "type": "object",
              "title": "Service account annotations"
            },
            "name": {
              "type": "string",
              "title": "Service account name"
            }
          }
        },
        "podAnnotations": {
          "type": "object",
          "title": "Pod annotations"
        },
        "podLabels": {
          "type": "object",
          "title": "Pod labels"
        },
        "podSecurityContext": {
          "type": "object",
          "title": "Pod security context"
        },
        "securityContext": {
          "type": "object",
          "title": "Container security context"
        },
        "service": {
          "type": "object",
          "title": "Service",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "title": "Service type",
              "enum": [
                "ClusterIP",
                "NodePort",
                "LoadBalancer"
              ]
            },
            "port": {
              "type": "integer",
              "title": "Service port"
            }
          }
        },
        "ingress": {
          "type": "object",
          "title": "Ingress",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "title": "Ingress enabled"
            },
            "className": {
              "type": "string",
              "title": "Ingress class name"
            },
            "annotations": {
              "type": "object",
              "title": "Ingress annotations"
            },
            "hosts": {
              "type": "array",
              "title": "Ingress hosts",
              "items": {
                "type": "object",
                "properties": {
                  "host": {
                    "type": "string"
                  },
                  "paths": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "path": {
                          "type": "string"
                        },
                        "pathType": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            },
            "tls": {
              "type": "array",
              "title": "Ingress TLS",
              "items": {
                "type": "object"
              }
            }
          }
        },
        "resources": {
          "type": "object",
          "title": "Resources"
        },
        "volumes": {
          "type": "array",
          "title": "Additional volumes",
          "items": {
            "type": "object"
          }
        },
        "volumeMounts": {
          "type": "array",
          "title": "Additional volume mounts",
          "items": {
            "type": "object"
          }
        },
        "nodeSelector": {
          "type": "object",
          "title": "Node selector"
        },
        "tolerations": {
          "type": "array",
          "title": "Tolerations",
          "items": {
            "type": "object"
          }
        },
        "affinity": {
          "type": "object",
          "title": "Affinity"
        },
        "env": {
          "type": "object",
          "title": "Environment variables",
          "additionalProperties": {
            "type": "string"
          }
        },
        "otel": {
          "type": "object",
          "description": "Node-local OTLP endpoint for the C8 audit trail. OFF by default: when enabled, an explicit env block sets OTEL_EXPORTER_OTLP_ENDPOINT to http://$(HOST_IP):<port>, which an env entry of the same name supplied via rdc.env would otherwise lose to.",
          "additionalProperties": false,
          "properties": {
            "nodeLocalEndpoint": {
              "type": "boolean",
              "description": "Set OTEL_EXPORTER_OTLP_ENDPOINT from the pod's status.hostIP. Required to reach a node-local collector, whose service is headless and has no cluster IP. Does not by itself enable the audit trail -- that needs OTEL_LOGS_ENABLED=true through rdc.env. The endpoint says WHERE and nothing about WHETHER: there are three independent switches, all defaulting to false -- OTEL_ENABLED (metrics), OTEL_TRACING_ENABLED (traces) and OTEL_LOGS_ENABLED (the audit trail). Measured on a live cluster: 34 controllers carried OTEL_LOGS_ENABLED=true with no OTEL_ENABLED key and exported audit rows, so OTEL_ENABLED=true alone gets metrics and traces and no audit trail (issue 729)."
            },
            "nodeLocalPort": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535,
              "description": "OTLP/HTTP port on the node-local collector."
            }
          }
        },
        "endpointAllowlist": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Hosts a credentialed request may reach, beyond those the OAS document names. Empty (the default) permits only the document's hosts. Entries are host[:port], optionally http:// prefixed, with an optional single leading *. wildcard. A path is refused at startup: write the host alone, not a document's full servers[0] URL."
        },
        "allowAnyHost": {
          "type": "boolean",
          "default": false,
          "description": "Disable endpoint-allowlist matching entirely. The unconditional refusals (loopback, link-local, multicast, unspecified) still apply."
        },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "description": "The generated controllers' metrics endpoint. 0 disables it, which is the default: until issue 772 the flag defaulted to 0 and nothing in this chart could set it, so the runtime's requeue-after and failure counters were incremented and discarded. Not on by default because a port on every generated controller is a surface change and nothing was measured scraping them.",
          "properties": {
            "port": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535,
              "description": "Port for the generated controllers' metrics server. 0 disables it. Set it when you add a scrape, not before."
            }
          },
          "required": [
            "port"
          ]
        },
        "healthProbePort": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "description": "Port for the generated controller's readiness endpoint at /readyz. 0 disables it. The check fails while the first list has not succeeded, and while the ownership lease cannot be READ OR WRITTEN -- which is the controller that reported Running and reconciled nothing (#815). A replica merely WAITING for a peer's lease is READY: waiting is healthy, exactly one replica holds the lease, and a NotReady standby would be the defect. IT MUST AGREE WITH rdc.readinessProbe.httpGet.port: a probe pointed at a port nothing binds marks EVERY pod NotReady, which is an outage produced by a diagnostic. A test asserts the two match. Setting this to 0 without also emptying rdc.readinessProbe is the same outage."
        },
        "readinessProbe": {
          "type": "object",
          "additionalProperties": true,
          "description": "Readiness probe for the generated controllers. Kubernetes probe configuration (httpGet/tcpSocket/exec + timing). The chart defaults it ON, pointed at /readyz on rdc.healthProbePort -- deliberately unlike rdc.metrics.port, because the defect it reports is invisible: six controllers were measured at avail=1 ready=1 restarts=0 while reconciling nothing. Empty disables it."
        },
        "livenessProbe": {
          "type": "object",
          "additionalProperties": true,
          "description": "Liveness probe for the generated controllers. DELIBERATELY EMPTY BY DEFAULT and it should stay that way: waiting for the ownership lease is HEALTHY -- exactly one replica holds it and the others are correct to wait -- so a liveness probe pointed at /readyz would restart every waiting replica in a loop, turning a working design into a crash loop. A test asserts it stays empty."
        }
      }
    },
    "env": {
      "type": "object",
      "title": "Environment variables",
      "additionalProperties": {
        "type": "string"
      },
      "properties": {
        "OASGEN_PROVIDER_DEBUG": {
          "type": "string",
          "title": "Debug logging"
        },
        "OASGEN_PROVIDER_MAX_RECONCILE_RATE": {
          "type": [
            "integer",
            "string"
          ],
          "title": "Max reconcile rate"
        }
      }
    },
    "global": {
      "type": "object",
      "title": "Global values",
      "description": "Helm global values (injected when this chart is used as a subchart).",
      "properties": {
        "imageRegistry": {
          "type": "string",
          "title": "Global image registry override",
          "description": "When set, replaces the registry host of every image in the chart. Repository paths preserved.",
          "default": ""
        }
      }
    },
    "livenessProbe": {
      "type": "object",
      "description": "Kubernetes probe configuration (httpGet/tcpSocket/exec + timing). Empty/unset uses chart defaults.",
      "additionalProperties": true
    },
    "readinessProbe": {
      "type": "object",
      "description": "Kubernetes probe configuration (httpGet/tcpSocket/exec + timing). Empty/unset uses chart defaults.",
      "additionalProperties": true
    }
  }
}
